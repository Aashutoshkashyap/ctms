# ==============================================================================
# BuildTrack CTMS - Environment Variable Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development, or configure these variables
# in your production hosting provider (e.g. Vercel, Docker, AWS ECS).
#
# IMPORTANT: DO NOT commit actual secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application Configuration (REQUIRED)
# ------------------------------------------------------------------------------
# Fully qualified URL where the application is accessible
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side cryptographic secret used for signing session tokens and state cookies
# Generate a cryptographically secure random 32+ byte string (e.g. `openssl rand -hex 32`)
BUILDTRACK_SESSION_SECRET=your_32_byte_session_secret_here

# ------------------------------------------------------------------------------
# 2. Supabase Persistence & Authentication (REQUIRED FOR CLOUD PERSISTENCE)
# ------------------------------------------------------------------------------
# Supabase project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase public anonymous API key (safe for client-side bundle)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service role secret key (SERVER-ONLY: NEVER expose via NEXT_PUBLIC_*)
# Used for server-side authorization enforcement, RLS bypass, and tenant administration
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 3. Scheduled Tasks & Automation (REQUIRED FOR CRON JOBS)
# ------------------------------------------------------------------------------
# Secret authorization token used to authenticate automated cron jobs
# (e.g. /api/cron/subscription-alerts, /api/cron/keepalive)
CRON_SECRET=your_cron_job_secret_token_here

# ------------------------------------------------------------------------------
# 4. AI Site Copilot / Tender Assistant (OPTIONAL)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 5. Google Workspace Integration - Drive & Gmail (OPTIONAL)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Client credentials (configured with Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Encryption key used to securely encrypt and decrypt Google refresh tokens in DB
# Must be at least 32 bytes (e.g. `openssl rand -hex 32`)
GOOGLE_TOKEN_ENCRYPTION_KEY=your_google_token_encryption_key_here

# Enable Gmail sending for Superadmin automated subscription notifications ('true'|'false')
GOOGLE_ENABLE_GMAIL_SEND=false

# ------------------------------------------------------------------------------
# 6. WhatsApp Field Operations & OpenWA Gateway (OPTIONAL)
# ------------------------------------------------------------------------------
WHATSAPP_ENABLED=false
OPENWA_TRANSPORT_ACTIVATED=false
WHATSAPP_OPENWA_ENDPOINT=
WHATSAPP_OPENWA_API_KEY=
WHATSAPP_OPENWA_WEBHOOK_SECRET=
OPENWA_WEBHOOK_SECRET_REF=
WHATSAPP_OPENWA_SIGNATURE_HEADER=x-webhook-signature
WHATSAPP_OPENWA_SESSION_ID=

# ------------------------------------------------------------------------------
# 7. Local Demo / Testing Gate (DEVELOPMENT ONLY - NEVER SET IN PRODUCTION)
# ------------------------------------------------------------------------------
# Optional JSON map of demo email to SHA-256 password hash for local development
# BUILDTRACK_DEMO_PASSWORD_HASHES_JSON={"demo@example.com":"hash"}
